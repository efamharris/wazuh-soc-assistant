# Copy into the Wazuh MCP Server's .env file and replace placeholders.
# The upstream server is pinned in wazuh-mcp-server.lock.
WAZUH_HOST=localhost
WAZUH_PORT=55000
WAZUH_USER=<READ_ONLY_WAZUH_API_USER>
WAZUH_PASS=<READ_ONLY_WAZUH_API_PASSWORD>
VERIFY_SSL=false
WAZUH_ALLOW_SELF_SIGNED=true
WAZUH_API_VERSION=v4
WAZUH_INDEXER_HOST=localhost
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=<READ_ONLY_INDEXER_USER>
WAZUH_INDEXER_PASS=<READ_ONLY_INDEXER_PASSWORD>
WAZUH_INDEXER_ALLOW_SELF_SIGNED=true
USE_INDEXER_FOR_ALERTS=true
USE_INDEXER_FOR_VULNERABILITIES=true
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
DEBUG=false
LOG_LEVEL=ERROR
MAX_ALERTS_PER_QUERY=100
MAX_AGENTS_PER_SCAN=10
CACHE_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
MAX_CONNECTIONS=10
POOL_SIZE=5
ENABLE_EXTERNAL_INTEL=true
ENABLE_ML_ANALYSIS=true
ENABLE_COMPLIANCE_CHECKING=true
ENABLE_EXPERIMENTAL=false
