# Copy to the .env file in your Wazuh MCP fork's source checkout.
# See integrations/wazuh-mcp-server.lock for the fork and tracking branch.

# Wazuh Manager API (required)
WAZUH_HOST=<REACHABLE_MANAGER_HOST_OR_IP>
WAZUH_PORT=55000
WAZUH_USER=<READ_ONLY_MANAGER_API_USER>
WAZUH_PASS=<READ_ONLY_MANAGER_API_PASSWORD>
WAZUH_VERIFY_SSL=true
WAZUH_ALLOW_SELF_SIGNED=false

# Wazuh Indexer (required for alerts, vulnerabilities, and alert-backed compliance)
WAZUH_INDEXER_HOST=<REACHABLE_INDEXER_HOST_OR_IP>
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=<READ_ONLY_INDEXER_USER>
WAZUH_INDEXER_PASS=<READ_ONLY_INDEXER_PASSWORD>
WAZUH_INDEXER_VERIFY_SSL=true

# MCP service: use bearer auth and read-only access. Do not enable the response toolset.
ENVIRONMENT=production
AUTH_MODE=bearer
MCP_API_KEY_SCOPES=wazuh:read
WAZUH_TOOLSETS=alerts,agents,vulnerabilities,analysis,compliance,system

# Generate these two secrets as described in the README; do not use placeholders.
AUTH_SECRET_KEY=<GENERATE_RANDOM_SECRET>
MCP_API_KEY=<GENERATE_READ_ONLY_API_KEY>

LOG_LEVEL=INFO
